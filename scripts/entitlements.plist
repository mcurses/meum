<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Release builds run with the hardened runtime (notarization requires it). Its library validation would only
       load libraries signed by meum's own team, which rules out widgets (dylibs from ~/.local/share/meum/widgets,
       built and signed by anyone). meum checks widgets itself (docs/design/widget-library.md, "Trust"). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
